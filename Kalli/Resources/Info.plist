<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- Menüleisten-App: kein Dock-Icon, kein Hauptfenster beim Start. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Sparkle. Der Appcast liegt IM REPO, nicht in einem Gist: Damit ist jede
	     Änderung daran ein öffentlicher, datierter Commit — die billigste
	     Manipulationserkennung, die zu haben ist.

	     SUPublicEDKey ist der ÖFFENTLICHE Teil des Signierschlüssels. Der
	     private Teil liegt ausschließlich im Login-Schlüsselbund des
	     Entwickler-Macs und darf niemals in dieses Repo geraten.

	     SUEnableAutomaticChecks fehlt hier ABSICHTLICH: Sparkle fragt dadurch
	     beim ersten Mal, ob es automatisch suchen darf. Kalli hatte bis 0.3.1
	     keinen Netzzugriff; ihn ab Werk einzuschalten wäre eine Vollmacht, die
	     niemand erteilt hat. Begründung: docs/AUTO-UPDATE-DESIGN.md -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/miwixyz/Kalli/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>iE2bazGoslgGEsgo2MJUwphVYlEKkeRcsWdzwbGge4w=</string>

	<!-- EdDSA-Signatur VOR dem Entpacken prüfen. Ohne diesen Schlüssel
	     akzeptiert Sparkle ein Update, wenn EINE der beiden Prüfungen
	     (EdDSA oder Code-Signatur) besteht — gedacht für Schlüsselwechsel,
	     heißt aber: ein Schlüssel genügt (Audit-Fund K-S4, 2026-09-27).
	     Mit YES ist die EdDSA-Signatur für ZIP-Updates Pflicht. Voraussetzung:
	     Jedes Appcast-Element trägt sparkle:edSignature (release.sh signiert).
	     Geht der private EdDSA-Schlüssel verloren, braucht der Wechsel laut
	     Sparkle-Doku ein Developer-ID-signiertes Disk-Image statt eines ZIP. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>

	<!-- Ohne diese beiden Texte schlägt der Zugriff STILL fehl (macOS 14+).
	     Der Nutzer sieht dann keinen Dialog, und die Liste bleibt einfach leer. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Kalli zeigt deine Termine im Menübalken an. Der Zugriff ist ausschließlich lesend — Kalli ändert nichts in deinen Kalendern.</string>
	<!-- Die ALTEN Schlüssel zusätzlich, obwohl macOS 14+ die FullAccess-Variante
	     verlangt. Gemessen am 2026-09-22: `requestFullAccessToEvents()` gab
	     sofort `false` zurück, ohne Dialog und ohne den Status zu ändern —
	     dreimal, bei frisch zurückgesetztem TCC und mit vorhandener,
	     befüllter FullAccess-Beschreibung. Das ist das Bild einer Anfrage, die
	     macOS direkt ablehnt. Diese Schlüssel kosten nichts und sind der
	     nächste prüfbare Verdacht. -->
	<key>NSCalendarsUsageDescription</key>
	<string>Kalli zeigt deine Termine im Menübalken an. Der Zugriff ist ausschließlich lesend — Kalli ändert nichts in deinen Kalendern.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Kalli zeigt deine Erinnerungen neben den Terminen an und lässt dich sie dort abhaken. Geändert wird ausschließlich das Erledigt-Kennzeichen.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Kalli zeigt deine Erinnerungen neben den Terminen an und lässt dich sie dort abhaken. Geändert wird ausschließlich das Erledigt-Kennzeichen — nichts wird angelegt, umbenannt oder gelöscht.</string>
</dict>
</plist>
